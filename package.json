{
	"name": "stk-proxy-state-manager",
	"version": "1.0.0",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "rslib build",
		"dev": "rslib build --watch",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"test": "rstest run",
		"test:watch": "rstest",
		"prepare": "rslib build"

	},
	"devDependencies": {
		"@eslint/js": "^9.39.3",
		"@rsbuild/core": "^1.7.1",
		"@rslib/core": "^0.19.6",
		"@rstest/core": "^0.7.8",
		"@stylistic/eslint-plugin": "^5.9.0",
		"eslint": "^9.39.3",
		"eslint-plugin-simple-import-sort": "^12.1.1",
		"globals": "^16.5.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.56.0"
	}
}
